# ReproZero runtime mode
REPROZERO_DEMO_MODE=true
REPROZERO_AWS_DEMO_REPOSITORY=
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=

# Clerk authentication (Phase 1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Neon Postgres + Drizzle (Phase 1)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Encrypts integration OAuth tokens (e.g. Jira) at rest before they're
# stored in Postgres. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Jira Cloud OAuth (Phase 2) — register at
# developer.atlassian.com/console/myapps, callback URL
# {APP_BASE_URL}/api/integrations/jira/callback
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=

# OpenAI runtime reasoning and patch generation
OPENAI_API_KEY=
OPENAI_MODEL=

# Greptile repository analysis
GREPTILE_API_KEY=
GREPTILE_API_URL=

# Claude-Mem retrieval and memory writes
CLAUDE_MEM_BASE_URL=
CLAUDE_MEM_API_KEY=

# AWS sandbox and artifact storage
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
REPROZERO_ARTIFACT_BUCKET=

# Stripe incident ingestion and webhook verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional private GitHub repository access (shared, workspace-wide —
# separate from the per-workspace OAuth connection below)
GITHUB_TOKEN=

# GitHub OAuth (Phase 6) — register at github.com/settings/developers
# (OAuth App, not GitHub App), callback URL
# {APP_BASE_URL}/api/integrations/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
